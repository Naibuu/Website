---
import type { Project } from '@/types'
import { Icon } from 'astro-icon/components'

import Box from '@/components/Base/Box.astro'
import Tag from '@/components/Base/Tag.astro'

const { icon, role, start, end, title, description, tasks, url } =
    Astro.props as Project

const date = end ? `${start} - ${end}` : `Since ${start}`
const hasTasks = tasks.length > 0
const isExternal = url?.startsWith('http')
---

<a href={url} target={isExternal ? '_blank' : undefined} class="flex-1">
    <Box className="gap-2">
        <!-- Title -->
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <img
                    src={icon}
                    alt={title}
                    width={24}
                    draggable={false}
                    class="opacity-60 select-none dark:invert"
                />

                <h4 class="font-medium text-neutral-700 dark:text-neutral-200">
                    {title}
                </h4>
            </div>
        </div>

        <!-- Meta -->
        <div class="flex flex-wrap items-center gap-2">
            <Tag>{role}</Tag>
            <Tag>
                <Icon name="ph:read-cv-logo" size={16} />
                {date}
            </Tag>
        </div>

        <!-- Description -->
        <p class="text-sm leading-6 text-neutral-500 dark:text-neutral-400">
            {description}
        </p>

        <!-- Tasks -->
        {
            hasTasks && (
                <div class="flex flex-col gap-2">
                    <button class="tasks-toggle inline-flex w-fit cursor-pointer items-center gap-1 rounded-full bg-zinc-200 px-3 py-1 text-xs font-medium text-neutral-800 hover:bg-zinc-300/80 dark:bg-zinc-800 dark:text-neutral-300 dark:hover:bg-zinc-700/50">
                        <span class="tasks-show-label">View tasks</span>
                        <span class="tasks-hide-label hidden">Hide tasks</span>

                        <Icon
                            name="ph:caret-down"
                            size={12}
                            class="tasks-show-icon"
                        />

                        <Icon
                            name="ph:caret-up"
                            size={12}
                            class="tasks-hide-icon hidden"
                        />
                    </button>

                    <ul class="tasks-list hidden list-disc space-y-1 pl-5 text-sm text-neutral-600 dark:text-neutral-400">
                        {tasks.map((task) => (
                            <li>{task}</li>
                        ))}
                    </ul>
                </div>
            )
        }
    </Box>
</a>

<script>
    import { onClickAll, queryChild, toggleElementClass } from '@/utils/dom'

    onClickAll<HTMLButtonElement>('.tasks-toggle', (button, event) => {
        event.preventDefault()
        event.stopPropagation()

        const card = button.closest('a')
        const tasks = queryChild<HTMLUListElement>(card, '.tasks-list')

        const showLabel = queryChild<HTMLSpanElement>(
            button,
            '.tasks-show-label',
        )

        const hideLabel = queryChild<HTMLSpanElement>(
            button,
            '.tasks-hide-label',
        )

        const showIcon = queryChild<HTMLElement>(button, '.tasks-show-icon')

        const hideIcon = queryChild<HTMLElement>(button, '.tasks-hide-icon')

        toggleElementClass(tasks, 'hidden')

        toggleElementClass(showLabel, 'hidden')
        toggleElementClass(hideLabel, 'hidden')

        toggleElementClass(showIcon, 'hidden')
        toggleElementClass(hideIcon, 'hidden')
    })
</script>
